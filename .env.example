# Inject via runtime; the server does not load .env files automatically.
PORT=8080
# Optional LINE prototype: supply all three together, or leave all absent.
LINE_MESSAGING_API_CHANNEL_ID=
LINE_MESSAGING_API_CHANNEL_SECRET=
LINE_MESSAGING_API_CHANNEL_ACCESS_TOKEN=
# Optional MINI App: supply Channel ID and LIFF ID together; enable openid scope.
LINE_MINI_APP_CHANNEL_ID=
LINE_MINI_APP_LIFF_ID=
# Reserved for future Service Message integration; not used by the current server.
LINE_MINI_APP_CHANNEL_ACCESS_TOKEN=
# Firestore for attendance/summary and cmd/firestorecheck; runtime ADC is required.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID="(default)"
# Optional summary module: configure all five, or leave all absent.
# Once deployed, all groups default to silent collection. See docs/features/summary.md.
GEMINI_API_KEY=
SUMMARY_MODEL=
SUMMARY_TASK_QUEUE=
SUMMARY_TASK_URL=
SUMMARY_TASK_SERVICE_ACCOUNT=
