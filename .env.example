# Inject via runtime; the server does not load .env files automatically.
PORT=8080
# Optional LINE prototype: supply all three together, or leave all absent.
LINE_MESSAGING_API_CHANNEL_ID=
LINE_MESSAGING_API_CHANNEL_SECRET=
LINE_MESSAGING_API_CHANNEL_ACCESS_TOKEN=
# Public MINI App configuration. Only the selected profile is required.
# developing (default), review or published; enable openid in that Channel.
LINE_MINI_APP_ENV=developing
LINE_MINI_APP_DEVELOPING_CHANNEL_ID=2012412007
LINE_MINI_APP_DEVELOPING_LIFF_ID=2012412007-0xCIzCmZ
LINE_MINI_APP_DEVELOPING_ENDPOINT_URL=https://line-mini-app-bot-jtghegqd7q-de.a.run.app/miniapp
LINE_MINI_APP_REVIEW_CHANNEL_ID=2012412008
LINE_MINI_APP_REVIEW_LIFF_ID=2012412008-L7dYhvM1
LINE_MINI_APP_REVIEW_ENDPOINT_URL=https://line-mini-app-bot-jtghegqd7q-de.a.run.app/miniapp
LINE_MINI_APP_PUBLISHED_CHANNEL_ID=2012412009
LINE_MINI_APP_PUBLISHED_LIFF_ID=2012412009-Xp2CQWOP
LINE_MINI_APP_PUBLISHED_ENDPOINT_URL=https://line-mini-app-bot-jtghegqd7q-de.a.run.app/miniapp
# Reserved for future integration; not read by the current server.
LINE_MINI_APP_CHANNEL_SECRET=
# Reserved for future Service Message integration; not used by the current server.
LINE_MINI_APP_CHANNEL_ACCESS_TOKEN=
# Firestore for attendance/summary and cmd/firestorecheck; runtime ADC is required.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID="(default)"
# Optional summary module: set the selected provider key, model and three task settings.
# Once deployed, all groups default to silent collection. See docs/domains/summary/summary.md.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional PDF candidate model; defaults to the existing OpenAI gpt-4.1-mini model.
OBJECT_IMPORT_MODEL=
# Optional Taiwan weather lookup.
CWA_API_KEY=
# Empty provider preserves Gemini; use openai for Chat Completions.
SUMMARY_PROVIDER=
SUMMARY_MODEL=
SUMMARY_TASK_QUEUE=
SUMMARY_TASK_URL=
SUMMARY_TASK_SERVICE_ACCOUNT=

# Optional agent evidence lookup (openai or gemini); uses the corresponding provider key.
AGENT_PROVIDER=
AGENT_MODEL=

# Optional private XLSX archive; configure bucket retention before enabling.
OBJECT_IMPORT_SOURCE_BUCKET=
