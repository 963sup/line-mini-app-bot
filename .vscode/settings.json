{
  "go.alternateTools": {
    "go": "${workspaceFolder}/scripts/tooling/go-tool.sh",
    "gopls": "${workspaceFolder}/scripts/tooling/gopls-tool.sh"
  },
  "go.toolsManagement.autoUpdate": false,
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "files.watcherExclude": {
    "**/graphify-out/**": true
  },
  "search.exclude": {
    "**/graphify-out/**": true,
    "**/repomix-output.*": true
  }
}
