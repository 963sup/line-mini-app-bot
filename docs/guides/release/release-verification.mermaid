flowchart TB
  baseline["保存原流量分配與具名 revisions、服務 URL、digest、服務帳戶及 Secret 版本"] --> candidate["核對候選 revision Ready、HTTP smoke、/location 與 /miniapp"]
  candidate --> config["核對測試環境的 LIFF Endpoint /miniapp、Messaging Webhook 路徑與渠道 ID"]
  config --> test["依驗收表測真實登入、個人與群組指令、Firestore 讀寫及本人出勤"]
  test --> gate{"候選驗收通過且已取得切流授權？"}
  gate -->|否| hold["保留原流量，處理未通過項目"]
  gate -->|是| switchTraffic["切換至具名候選 revision"]
  switchTraffic --> observe{"監測結果達回復門檻？"}
  observe -->|否| keep["維持候選流量"]
  observe -->|是| restore["停止擴大發布，還原原 revision 或原分流"]
  restore --> confirm["重驗 snapshot、digest、HTTP、LINE 收訊、真實登入與查詢"]
