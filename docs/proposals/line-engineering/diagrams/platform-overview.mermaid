flowchart TD
    U["LINE 使用者"]

    subgraph L["LINE 平台"]
        D["LINE Developers · Provider"]
        M["Messaging API Channel"]
        C["LINE MINI App Channel"]
        OA["LINE Official Account"]
        DM["1:1 私訊"]
        GR["LINE 工程群組"]
        LIFF["MINI App · LIFF SDK"]
        D --> M
        D --> C
        M --- OA
        OA --- DM
        OA --- GR
        C --> LIFF
    end

    subgraph APP["Cloud Run · 單一 Go 服務"]
        WH["Webhook Handler"]
        WEB["Next.js / React 靜態頁面"]
        AUTH["Identity / Session / Authorization"]
        API["HTTP API"]
        CORE["Business Use Cases"]
        FILE["File Service"]
        JOB["通知與背景工作入口"]
    end

    subgraph DATA["Google Cloud"]
        DB[("Firestore · 結構化資料")]
        ST[("Firebase Storage / Cloud Storage · 檔案")]
        TASK["Cloud Tasks / Scheduler"]
        SM["Secret Manager"]
    end

    U --> DM
    U --> GR
    U --> LIFF

    DM --> M
    GR --> M
    M -->|"Webhook"| WH
    WH --> CORE
    WH --> JOB
    CORE -->|"Reply / Push"| M

    LIFF -->|"取得網頁"| WEB
    LIFF -->|"ID Token / Session"| AUTH
    WEB -->|"API 請求"| API
    API --> AUTH
    API --> CORE
    API --> FILE

    CORE <--> DB
    AUTH <--> DB
    FILE <--> DB
    FILE <--> ST

    TASK --> JOB
    JOB --> DB
    JOB --> M
    SM -.->|"機密設定"| APP
