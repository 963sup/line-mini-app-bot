{
  "name": "@repo/miniapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node ../../scripts/tooling/prepare-miniapp-assets.mjs",
    "dev": "pnpm prepare-assets && next dev --port 3000",
    "build": "pnpm prepare-assets && next build",
    "check": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.json --import ./tests/dom-setup.ts --test tests/*.test.tsx"
  },
  "dependencies": {
    "@repo/api-client": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
