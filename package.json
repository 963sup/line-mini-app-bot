{
  "name": "line-mini-app-bot",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "turbo run build --filter @repo/miniapp && turbo run dev",
    "api:generate": "node scripts/api-generate.mjs",
    "api:check": "node scripts/api-generate.mjs --check && pnpm api:compat",
    "check": "pnpm api:check && python3 scripts/check-config.py && turbo run check",
    "test": "turbo run test",
    "build": "turbo run build",
    "api:compat": "node scripts/api-compat.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "@redocly/cli": "2.15.0",
    "openapi-typescript": "7.13.0"
  }
}
