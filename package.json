{
  "name": "line-mini-app-bot",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "turbo run build --filter @repo/miniapp && turbo run dev",
    "api:generate": "node scripts/generate/api-generate.mts",
    "api:check": "pnpm scripts:typecheck && node --test scripts/test/check-dispatch.test.mts && node scripts/contract/check-capabilities.mts && node scripts/generate/api-generate.mts --check",
    "check": "pnpm api:check && python3 scripts/check/check-config.py && turbo run check",
    "test": "turbo run test",
    "build": "turbo run build",
    "scripts:typecheck": "tsc -p tsconfig.scripts.json",
    "api:compat": "node --test scripts/test/check-compatibility.test.mts && node scripts/contract/check-compatibility.mts",
    "format:check": "prettier --check \"frontend/miniapp/src/**/*.{ts,tsx}\" \"frontend/miniapp/tests/**/*.{ts,tsx}\" \"api/client/src/**/*.ts\" \"scripts/**/*.mts\"",
    "format": "prettier --write \"frontend/miniapp/src/**/*.{ts,tsx}\" \"frontend/miniapp/tests/**/*.{ts,tsx}\" \"api/client/src/**/*.ts\" \"scripts/**/*.mts\""
  },
  "devDependencies": {
    "@redocly/cli": "2.15.0",
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
