{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".agents/skills/**",
      ".codex/skills/**",
      "graphify-out/**",
      ".env",
      ".env.*",
      "**/*.pem",
      "**/*.key",
      "**/credentials*.json",
      "**/service-account*.json",
      ".git/**",
      "node_modules/**",
      "vendor/**",
      ".venv/**",
      "**/__pycache__/**",
      "bin/**",
      "coverage.out",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
